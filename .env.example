# Flagsmith Client-Side Environment Key (Get this from Flagsmith Dashboard -> Environment Settings)
NEXT_PUBLIC_FLAGSMITH_ENV_KEY=your_flagsmith_client_side_environment_key

# Optional: Custom SQLite DB path (defaults to ./focuspulse.db in workspace root; set to /data/focuspulse.db on Railway/Render)
DATABASE_PATH=./focuspulse.db

# Admin secret required by POST /api/stats (simulate & reset actions)
ADMIN_SECRET=change_me_before_deploy

# Show Simulate/Reset demo buttons on /results without ?admin=1 (keep false in production)
NEXT_PUBLIC_ENABLE_DEMO_CONTROLS=false
